{
  "version": "rq1-a-v1",
  "lock_date": "2026-09-23",
  "stage": "A",
  "split": {
    "seed": 42,
    "ratios": [0.7, 0.15, 0.15],
    "manifest": "data/processed/student_split.json",
    "manifest_sha256": "7b7a5e10f9c8b6dcd8ef4efa3965c3ef738ff32d23907e91e0f2050622afd27d",
    "raw_sha256": "162ef8d2d28bcbfea6591a282994062bd8d5eaa00636544292a0d268dca6e5da",
    "reuse_manifest": true,
    "unit": "user_id"
  },
  "cleaning": {
